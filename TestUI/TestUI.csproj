<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyVersion>1.0.2.22090</AssemblyVersion>
    <FileVersion>1.0.2.22090</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <ShouldCreateLogs>True</ShouldCreateLogs>
    <AdvancedSettingsExpanded>False</AdvancedSettingsExpanded>
    <UpdateAssemblyInfoVersion>False</UpdateAssemblyInfoVersion>
    <AssemblyVersionSettings>None.None.None.None</AssemblyVersionSettings>
    <UpdatePackageVersion>False</UpdatePackageVersion>
    <AssemblyInfoVersionType>SettingsVersion</AssemblyInfoVersionType>
    <InheritWinAppVersionFrom>None</InheritWinAppVersionFrom>
    <AssemblyFileVersionSettings>None.None.None.None</AssemblyFileVersionSettings>
    <UpdateAssemblyVersion>False</UpdateAssemblyVersion>
    <UpdateAssemblyFileVersion>False</UpdateAssemblyFileVersion>
    <PackageVersionSettings>AssemblyVersion.IncrementOnce.Beta</PackageVersionSettings>
    <DebugType>embedded</DebugType>
    <FileAlignment>4096</FileAlignment>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <FileAlignment>4096</FileAlignment>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <ShouldCreateLogs>True</ShouldCreateLogs>
    <AdvancedSettingsExpanded>False</AdvancedSettingsExpanded>
    <UpdateAssemblyVersion>True</UpdateAssemblyVersion>
    <UpdateAssemblyFileVersion>True</UpdateAssemblyFileVersion>
    <UpdateAssemblyInfoVersion>False</UpdateAssemblyInfoVersion>
    <AssemblyFileVersionSettings>NoneWithAutoReset.NoneWithAutoReset.IncrementWithResetOnIncrease.DateStamp</AssemblyFileVersionSettings>
    <UpdatePackageVersion>True</UpdatePackageVersion>
    <AssemblyInfoVersionType>SettingsVersion</AssemblyInfoVersionType>
    <InheritWinAppVersionFrom>None</InheritWinAppVersionFrom>
    <AssemblyVersionSettings>NoneWithAutoReset.NoneWithAutoReset.IncrementWithResetOnIncrease.DateStamp</AssemblyVersionSettings>
    <PackageVersionSettings>AssemblyVersion.IncrementOnce.Alpha</PackageVersionSettings>
    <DebugType>embedded</DebugType>
    <FileAlignment>4096</FileAlignment>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
    <FileAlignment>4096</FileAlignment>
  </PropertyGroup>

	<ItemGroup Condition="Exists('..\..\GIMzip\GimBin\GimBin.csproj')">
		<ProjectReference Include="..\..\GIMzip\GimBin\GimBin.csproj" />
		<ProjectReference Include="..\..\GIMzip\GimCrypt\GimCrypt.csproj" />
	</ItemGroup>

	<ItemGroup Condition="!Exists('..\..\GIMzip\GimBin\GimBin.csproj')">
		<PackageReference Include="GimBin" Version="1.0.10" />
		<PackageReference Include="GimCrypt" Version="1.0.10" />
	</ItemGroup>

<Choose>
		<When Condition="Exists('..\..\GIMtwin\GIMtwin\GIMtwin\GIMtwin.csproj')" />
		<Otherwise />
	</Choose>


	

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.1.0" />
    <PackageReference Include="RamDisk" Version="1.0.5" />
  </ItemGroup>



  <ItemGroup>
    <ProjectReference Include="..\GIMCompress\GIMCompress.csproj" />
    <ProjectReference Include="..\GIMtransfer\GIMtransfer.csproj">
      <Private>True</Private>
      <CopyLocalSatelliteAssemblies>True</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="GIMocctCLI">
      <HintPath>..\GIMocctWrapper (DLL)\GIMocctCLI.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="GIMocctWrapper">
      <HintPath>..\GIMocctWrapper (DLL)\GIMocctWrapper.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- Compile against the ship drop. Runtime: Debug TestUI uses GIMocctWrapper (DLL)/Debug
       when a Debug CLI build has populated it; otherwise the RelWithDebInfo ship set. -->
  <PropertyGroup>
    <GimOcctDrop>$(MSBuildThisFileDirectory)..\GIMocctWrapper (DLL)</GimOcctDrop>
    <GimOcctDropDebug>$(GimOcctDrop)\Debug</GimOcctDropDebug>
  </PropertyGroup>

  <Target Name="CopyOcctNatives" AfterTargets="PostBuildEvent">
    <Exec
      Condition="'$(Configuration)' == 'Debug' And Exists('$(GimOcctDropDebug)\GIMocctCLI.dll')"
      Command="xcopy /Y &quot;$(GimOcctDropDebug)\*.dll&quot; &quot;$(OutDir)&quot;" />
    <Exec
      Condition="'$(Configuration)' != 'Debug' Or !Exists('$(GimOcctDropDebug)\GIMocctCLI.dll')"
      Command="xcopy /Y &quot;$(GimOcctDrop)\*.dll&quot; &quot;$(OutDir)&quot;" />
  </Target>




</Project>