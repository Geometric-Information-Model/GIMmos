<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;AnyCPU</Platforms>
    <AssemblyVersion>1.0.2.22090</AssemblyVersion>
    <FileVersion>1.0.2.22090</FileVersion>
    <OutputType>Library</OutputType>
    <PackageId>GIMcompress</PackageId>
    <RepositoryUrl>https://github.com/Geometric-Information-Model/GIMmos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>NUGET-NOTICES.md</PackageLicenseFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <ShouldCreateLogs>True</ShouldCreateLogs>
    <AdvancedSettingsExpanded>False</AdvancedSettingsExpanded>
    <UpdateAssemblyVersion>True</UpdateAssemblyVersion>
    <UpdateAssemblyFileVersion>True</UpdateAssemblyFileVersion>
    <UpdateAssemblyInfoVersion>False</UpdateAssemblyInfoVersion>
    <AssemblyVersionSettings>NoneWithAutoReset.NoneWithAutoReset.IncrementWithResetOnIncrease.DateStamp</AssemblyVersionSettings>
    <UpdatePackageVersion>True</UpdatePackageVersion>
    <AssemblyInfoVersionType>SettingsVersion</AssemblyInfoVersionType>
    <InheritWinAppVersionFrom>None</InheritWinAppVersionFrom>
    <AssemblyFileVersionSettings>NoneWithAutoReset.NoneWithAutoReset.IncrementWithResetOnIncrease.DateStamp</AssemblyFileVersionSettings>
    <PackageVersionSettings>AssemblyVersion.IncrementOnce.Alpha</PackageVersionSettings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.3.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.1.0" />
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GimLogger\GimUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\legal\NUGET-NOTICES.md" Pack="true" PackagePath="NUGET-NOTICES.md" />
    <None Include="..\IFCOPENSHELL-SOURCE-RELINK.md" Pack="true" PackagePath="legal\IFCOPENSHELL-SOURCE-RELINK.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="legal\LICENSE" />
    <None Include="..\EXCEPTIONS.md" Pack="true" PackagePath="legal\EXCEPTIONS.md" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="legal\THIRD_PARTY_NOTICES.md" />
    <None Include="..\PROPRIETARY_COMPONENTS.md" Pack="true" PackagePath="legal\PROPRIETARY_COMPONENTS.md" />
  </ItemGroup>

</Project>
