{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/gim-preload.ps1"
      }
    ],
    "preToolUse": [
      {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON .cursor/hooks/gim-permissions.mjs"
      },
      {
        "matcher": "Task",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/gim-preload.ps1"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON .cursor/hooks/gim-permissions.mjs"
      }
    ]
  }
}
