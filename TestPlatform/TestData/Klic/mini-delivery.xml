<?xml version="1.0" encoding="UTF-8"?>
<!--
  Handcrafted mini IMKL 2.0 (KLIC) delivery used by KlicImklReaderTests.
  Deliberately rich: two owners x two themes, LineString + Curve utility links
  (including a multi-segment Curve), a dig-request polygon, nil/sentinel/9999 dates,
  nil and real widths plus width-looking false positives, all three CRS spellings,
  codelist variants (paired and self-closing), mixed dashed/dotted peer-id styles,
  one owner block and one feature serialized on a single line, an inline (redundant)
  namespace declaration mid-file, and several support features that must be ignored.
-->
<imkl:GebiedsinformatieLevering
    xmlns:imkl="http://www.imkl.nl/2.0"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:us-net-common="http://www.kadaster.nl/us-net-common/2.0"
    xmlns:net="http://www.kadaster.nl/net/2.0"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.imkl.nl/2.0 http://www.kadaster.nl/schemas/imkl-wibon-2.0.xsd"
    gml:id="nl.imkl-KL1040.levering.26O0074042">

  <gml:boundedBy>
    <gml:Envelope srsName="urn:ogc:def:crs:EPSG::28992">
      <gml:lowerCorner>150000 450000</gml:lowerCorner>
      <gml:upperCorner>151000 451000</gml:upperCorner>
    </gml:Envelope>
  </gml:boundedBy>

  <imkl:GebiedsinformatieAanvraag gml:id="nl.imkl-KL1040.aanvraag.1">
    <imkl:woonplaatsNaam>Arnhem</imkl:woonplaatsNaam>
    <imkl:straatnaam>Kerkstraat</imkl:straatnaam>
  </imkl:GebiedsinformatieAanvraag>

  <imkl:klicMeldnummer>26O0074042</imkl:klicMeldnummer>
  <imkl:leveringsvolgnummer>2</imkl:leveringsvolgnummer>

  <imkl:Beheerders>
    <imkl:Beheerder>
      <imkl:bronhoudercode>KL1040</imkl:bronhoudercode>
      <imkl:naam>Liander</imkl:naam>
    </imkl:Beheerder>
    <imkl:Belanghebbende gml:id="nl.imkl-KL1040.belanghebbende.1">
      <imkl:naam>Deze naam mag niet winnen</imkl:naam>
    </imkl:Belanghebbende>
    <imkl:Beheerder><imkl:bronhoudercode>GM0202</imkl:bronhoudercode><imkl:naam>Gemeente Arnhem</imkl:naam></imkl:Beheerder>
  </imkl:Beheerders>

  <imkl:Netwerken>
    <imkl:Utiliteitsnet gml:id="nl.imkl-KL1040.net.middenspanning">
      <us-net-common:utilityNetworkType codeSpace="http://www.kadaster.nl/codes/utilityNetworkType">http://www.kadaster.nl/codes/utilityNetworkType/elektriciteit</us-net-common:utilityNetworkType>
      <imkl:thema>http://www.kadaster.nl/codes/thema/middenspanning</imkl:thema>
    </imkl:Utiliteitsnet>
    <imkl:Utiliteitsnet gml:id="nl.imkl-GM0202.net.riool">
      <us-net-common:utilityNetworkType xlink:href="http://www.kadaster.nl/codes/utilityNetworkType/riolering"/>
      <imkl:thema xlink:href="http://www.kadaster.nl/codes/thema/riool"/>
    </imkl:Utiliteitsnet>
    <!-- Dotted peer-id style: must canonicalize to nl.imkl-KL1128.net.dotted. -->
    <imkl:Utiliteitsnet gml:id="nl.imkl.KL1128.net.dotted">
      <us-net-common:utilityNetworkType xlink:href="http://www.kadaster.nl/codes/utilityNetworkType/elektriciteit"/>
      <imkl:thema xlink:href="http://www.kadaster.nl/codes/thema/laagspanning"/>
    </imkl:Utiliteitsnet>
  </imkl:Netwerken>

  <imkl:SelectionArea>
    <imkl:Orientatiepolygoon gml:id="nl.imkl-KL1040.orientatie.1">
      <imkl:geometrie>
        <gml:Polygon srsName="EPSG:28992">
          <gml:exterior>
            <gml:LinearRing>
              <gml:posList>150000 450000 151000 450000 151000 451000 150000 451000 150000 450000</gml:posList>
            </gml:LinearRing>
          </gml:exterior>
        </gml:Polygon>
      </imkl:geometrie>
    </imkl:Orientatiepolygoon>
  </imkl:SelectionArea>

  <imkl:Maatvoering gml:id="nl.imkl-KL1040.maatvoering.1">
    <imkl:geometrie>
      <gml:LineString><gml:posList>1 1 2 2</gml:posList></gml:LineString>
    </imkl:geometrie>
