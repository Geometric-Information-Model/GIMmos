<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AssemblyVersion>1.0.2.22090</AssemblyVersion>
    <FileVersion>1.0.2.22090</FileVersion>
    <PackageId>GIMtransfer</PackageId>
    <RepositoryUrl>https://github.com/Geometric-Information-Model/GIMmos</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
    <PackageLicenseFile>NUGET-NOTICES.md</PackageLicenseFile>
  </PropertyGroup>

  <PropertyGroup>
    <GitBranch>$([System.IO.File]::ReadAlltext('$(MsBuildThisFileDirectory)..\.git\HEAD').Replace('ref: refs/heads/', '').Trim())</GitBranch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <DocumentationFile></DocumentationFile>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DocumentationFile>..\..\docXML\GIMtransfer.xml</DocumentationFile>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\GIMzip\GimBin\GimBin.csproj')">
    <ProjectReference Include="..\..\GIMzip\GimBin\GimBin.csproj" />
    <ProjectReference Include="..\..\GIMzip\GimCrypt\GimCrypt.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\..\GIMzip\GimBin\GimBin.csproj')">
    <PackageReference Include="GimBin" Version="1.0.10" />
    <PackageReference Include="GimCrypt" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>

    <Content Include="..\CadexLib\vc14.2\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <PackageReference Include="ACadSharp" Version="3.4.2" />

    <PackageReference Include="GeometryGymIFC_Core" Version="25.7.30" />

    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <PackageReference Include="NLog" Version="6.1.0" />

    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />

    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />

    <PackageReference Include="StirlingLabs.Assimp.Net" Version="23.4.1" />

    <PackageReference Include="Svg" Version="3.4.7" />

    <ProjectReference Include="..\GIMCompress\GIMCompress.csproj" />
    <ProjectReference Include="..\GimLogger\GimUtilities.csproj" />

    <Reference Include="GIMocctCLI">
      <HintPath>..\GIMocctWrapper (DLL)\GIMocctCLI.dll</HintPath>
    </Reference>

    <Reference Include="GIMocctWrapper">
      <HintPath>..\GIMocctWrapper (DLL)\GIMocctWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="StirlingLabs.assimp.native.win-x64" Version="5.2.5.4" />
  </ItemGroup>

  <ItemGroup>
		<None Include="..\GIMocctWrapper (DLL)\*.dll" Pack="true" PackagePath="native\" />

		<None Include="Gimtransfer.targets" Pack="true" PackagePath="build\GIMtransfer.targets" />
    <None Include="..\legal\NUGET-NOTICES.md" Pack="true" PackagePath="NUGET-NOTICES.md" />
    <None Include="..\IFCOPENSHELL-SOURCE-RELINK.md" Pack="true" PackagePath="legal\IFCOPENSHELL-SOURCE-RELINK.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="legal\LICENSE" />
    <None Include="..\EXCEPTIONS.md" Pack="true" PackagePath="legal\EXCEPTIONS.md" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="legal\THIRD_PARTY_NOTICES.md" />
    <None Include="..\PROPRIETARY_COMPONENTS.md" Pack="true" PackagePath="legal\PROPRIETARY_COMPONENTS.md" />
   </ItemGroup>

</Project>
